{
  "HostMode": "Deployment",
  "PathBase": "/",
  "Deployment": {
    "PublicOrigin": "https://stock.example.invalid",
    "Identity": {
      "Authority": "https://identity.example.invalid",
      "Issuer": "https://identity.example.invalid",
      "ClientId": "REPLACE_WITH_REGISTERED_CLIENT",
      "NameClaim": "name",
      "RoleClaim": "roles"
    },
    "DataProtection": {
      "ApplicationName": "Stockroom-production-v1",
      "KeyDirectory": "/REPLACE/stockroom-keys",
      "Certificate": {
        "Path": "/REPLACE/key-encryption.pfx"
      },
      "PreviousCertificates": []
    },
    "Transport": {
      "Mode": "DirectHttps",
      "ListenAddress": "127.0.0.1",
      "Port": 7443,
      "Certificate": {
        "Path": "/REPLACE/https.pfx"
      },
      "KnownProxies": []
    },
    "State": {
      "DatabasePath": "/REPLACE/stockroom-data/stock.db"
    }
  }
}
