@{
    ViewBag.Title = "Home Page";
}

<div class="jumbotron">
    <h1>ASP.NET MVC with 5000+ Routes</h1>
    <p class="lead">@ViewBag.Message</p>
    <p><strong>Total Routes: @ViewBag.RouteCount</strong></p>
    <p><a href="@Url.Action("RouteInfo", "Home")" class="btn btn-primary btn-lg">View Route Information &raquo;</a></p>
</div>

<div class="row">
    <div class="col-md-6">
        <h2>Route Testing</h2>
        <p>Test various route patterns and URL generation:</p>
        
        <h3>Simple Routes</h3>
        <ul>
            <li><a href="@Url.Action("Index", "Home")">@Url.Action("Index", "Home")</a></li>
            <li><a href="@Url.Action("About", "Home")">@Url.Action("About", "Home")</a></li>
            <li><a href="@Url.Action("Contact", "Home")">@Url.Action("Contact", "Home")</a></li>
            <li><a href="@Url.Action("Details", "Home", new { id = 123 })">@Url.Action("Details", "Home", new { id = 123 })</a></li>
        </ul>

        <h3>Complex Parameter Routes</h3>
        <ul>
            <li><a href="@Url.RouteUrl("Products", new { category = "electronics", id = 456 })">@Url.RouteUrl("Products", new { category = "electronics", id = 456 })</a></li>
            <li><a href="@Url.RouteUrl("Users", new { username = "john_doe" })">@Url.RouteUrl("Users", new { username = "john_doe" })</a></li>
            <li><a href="@Url.RouteUrl("Orders", new { orderId = 789, itemId = 101 })">@Url.RouteUrl("Orders", new { orderId = 789, itemId = 101 })</a></li>
            <li><a href="@Url.RouteUrl("Blog", new { year = 2024, month = 01, slug = "test-post" })">@Url.RouteUrl("Blog", new { year = 2024, month = 01, slug = "test-post" })</a></li>
        </ul>

        <h3>Search and Filter Routes</h3>
        <ul>
            <li><a href="@Url.Action("Search", "Home", new { query = "test", page = 1 })">@Url.Action("Search", "Home", new { query = "test", page = 1 })</a></li>
            <li><a href="@Url.RouteUrl("Search", new { query = "search-term", page = 1 })">@Url.RouteUrl("Search", new { query = "search-term", page = 1 })</a></li>
        </ul>
    </div>

    <div class="col-md-6">
        <h2>Enterprise Routes</h2>
        <p>Test enterprise-level route patterns:</p>

        <h3>File Management</h3>
        <ul>
            <li><a href="@Url.RouteUrl("Files", new { path = "documents", filename = "report.pdf" })">@Url.RouteUrl("Files", new { path = "documents", filename = "report.pdf" })</a></li>
        </ul>

        <h3>Reporting & Analytics</h3>
        <ul>
            <li><a href="@Url.RouteUrl("Reports", new { type = "sales", date = "2024-01-15" })">@Url.RouteUrl("Reports", new { type = "sales", date = "2024-01-15" })</a></li>
            <li><a href="@Url.RouteUrl("Analytics", new { metric = "views", period = "daily" })">@Url.RouteUrl("Analytics", new { metric = "views", period = "daily" })</a></li>
        </ul>

        <h3>Communication</h3>
        <ul>
            <li><a href="@Url.RouteUrl("Notifications", new { type = "email", id = 123 })">@Url.RouteUrl("Notifications", new { type = "email", id = 123 })</a></li>
            <li><a href="@Url.RouteUrl("Messages", new { threadId = 456, messageId = 789 })">@Url.RouteUrl("Messages", new { threadId = 456, messageId = 789 })</a></li>
        </ul>

        <h3>Project Management</h3>
        <ul>
            <li><a href="@Url.RouteUrl("Events", new { eventId = 101, attendeeId = 202 })">@Url.RouteUrl("Events", new { eventId = 101, attendeeId = 202 })</a></li>
            <li><a href="@Url.RouteUrl("Projects", new { projectId = 303, taskId = 404 })">@Url.RouteUrl("Projects", new { projectId = 303, taskId = 404 })</a></li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>Child Actions Demo</h2>
        <p>This section demonstrates child actions using @Html.RenderAction():</p>
        
        <div class="row">
            <div class="col-md-4">
                <h3>Navigation</h3>
                @Html.Action("Navigation", "Home")
            </div>
            <div class="col-md-4">
                <h3>Sidebar</h3>
                @Html.Action("Sidebar", "Home")
            </div>
            <div class="col-md-4">
                <h3>Footer</h3>
                @Html.Action("Footer", "Home")
            </div>
        </div>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>URL Generation Examples</h2>
        <p>Demonstrating various URL generation patterns:</p>
        
        <h3>Action Links</h3>
        <ul>
            <li>@Html.ActionLink("Home Index", "Index", "Home")</li>
            <li>@Html.ActionLink("Product Details", "Products", "Home", new { category = "electronics", id = 123 }, null)</li>
            <li>@Html.ActionLink("User Profile", "Users", "Home", new { username = "john_doe" }, null)</li>
        </ul>

        <h3>Route Links</h3>
        <ul>
            <li>@Html.RouteLink("Products Route", "Products", new { category = "electronics", id = 456 })</li>
            <li>@Html.RouteLink("Users Route", "Users", new { username = "jane_smith" })</li>
            <li>@Html.RouteLink("Orders Route", "Orders", new { orderId = 789, itemId = 101 })</li>
        </ul>

        <h3>API Routes</h3>
        <ul>
            <li><a href="/api/api">API Controller - Get All</a></li>
            <li><a href="/api/api/123">API Controller - Get by ID</a></li>
            <li><a href="/api/user">User API - Get All</a></li>
            <li><a href="/api/user/456">User API - Get by ID</a></li>
            <li><a href="/api/product">Product API - Get All</a></li>
            <li><a href="/api/product/789">Product API - Get by ID</a></li>
        </ul>
    </div>
</div>

<div class="row">
    <div class="col-md-12">
        <h2>Sample Routes</h2>
        <p>Showing first 10 routes from the collection:</p>
        <div class="table-responsive">
            <table class="table table-striped">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>URL Pattern</th>
                        <th>Defaults</th>
                        <th>Constraints</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var route in ViewBag.Routes)
                    {
                        <tr>
                            <td>@route.Name</td>
                            <td><code>@route.Url</code></td>
                            <td>@string.Join(", ", route.Defaults)</td>
                            <td>@string.Join(", ", route.Constraints)</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>